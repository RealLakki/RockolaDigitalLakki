# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# YouTube Data API v3 — restringe la key por HTTP referrer en Google Cloud Console
VITE_YOUTUBE_API_KEY=AIza...

# Last.fm API — para enriquecer tracks con tags de género reales (mucho más
# granular que iTunes). Crear key en https://www.last.fm/api/account/create
# Si está vacío, el filtro de género usa solo iTunes (menos preciso).
VITE_LASTFM_API_KEY=

# Endpoint de la Edge Function de Supabase que devuelve el token de Spotify (Client Credentials).
# Por defecto: <SUPABASE_URL>/functions/v1/spotify-token
VITE_SPOTIFY_TOKEN_ENDPOINT=
